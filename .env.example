# Site (Vite) - Supabase Dashboard > Project Settings > API
# Lokal gelistirme icin bu dosyayi .env olarak kopyalayin ve degerleri doldurun.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Panel erisimi (virgulle birden fazla e-posta; supabase/phase-b.sql admin_allowlist ile eslesmeli)
# VITE_ADMIN_EMAILS=admin@hakanyemcilik.com

# Urun gorselleri (opsiyonel; varsayilan GitHub Pages CDN)
# VITE_PRODUCT_IMAGE_BASE=https://yigitugurlucimen.github.io/hakanyemcilik

# Sadece seed script / GitHub Actions icin (.env veya repo Secrets; commit ETMEYIN)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# GitHub Actions > Secrets (canli build + seed):
# VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_ADMIN_EMAILS (opsiyonel)
# Cloudflare: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID
